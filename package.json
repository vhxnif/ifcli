{
    "name": "@vhxnif/ifcli",
    "version": "0.1.21",
    "description": "Chat with AI via CLI",
    "keywords": [
        "ai",
        "cli",
        "pi",
        "pi-agent",
        "reasoning",
        "MCP Client",
        "MCP-sse",
        "MCP-stdio",
        "MCP-http",
        "bun",
        "chat"
    ],
    "license": "MIT",
    "type": "module",
    "author": "vhxnif",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vhxnif/ifcli.git"
    },
    "files": [
        "build",
        "README.md"
    ],
    "engines": {
        "bun": ">=1.2.6"
    },
    "bin": {
        "ict": "build/chat-command.js",
        "ifchat": "build/chat-command.js",
        "ist": "build/setting-command.js",
        "ifsetting": "build/setting-command.js"
    },
    "scripts": {
        "build": "bun build ./src/*-command.ts --outdir ./build --target bun --minify",
        "build-dev": "bun build ./src/*-command.ts --outdir ./build --target bun --minify --sourcemap=linked",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "check": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.10",
        "@commander-js/extra-typings": "^15.0.0",
        "@types/bun": "^1.2.7",
        "bun-types": "^1.2.7"
    },
    "peerDependencies": {
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@earendil-works/pi-agent-core": "^0.84.3",
        "@earendil-works/pi-ai": "^0.84.3",
        "@inquirer/checkbox": "^5.2.2",
        "@inquirer/core": "^12.0.0",
        "@inquirer/input": "^5.1.3",
        "@inquirer/search": "^4.3.1",
        "@inquirer/select": "^5.2.2",
        "@modelcontextprotocol/sdk": "^1.11.4",
        "chalk": "^6.0.0",
        "commander": "^15.0.0",
        "ora": "^9.4.1",
        "unicode-animations": "^1.0.3"
    }
}
