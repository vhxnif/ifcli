{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ifcli Custom Tools",
    "description": "ifcli 自定义工具配置文件 Schema",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string",
            "description": "JSON Schema 文件路径"
        },
        "tools": {
            "type": "array",
            "description": "自定义工具定义列表",
            "items": {
                "type": "object",
                "properties": {
                    "def": {
                        "type": "object",
                        "properties": {
                            "type": { "type": "string", "const": "function" },
                            "function": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "工具唯一名称"
                                    },
                                    "description": {
                                        "type": "string",
                                        "description": "AI 根据此描述决定何时调用"
                                    },
                                    "parameters": {
                                        "type": "object",
                                        "properties": {
                                            "type": {
                                                "type": "string",
                                                "const": "object"
                                            },
                                            "properties": {
                                                "type": "object",
                                                "additionalProperties": {
                                                    "type": "object",
                                                    "properties": {
                                                        "type": {
                                                            "type": "string",
                                                            "enum": [
                                                                "string",
                                                                "number",
                                                                "boolean",
                                                                "array",
                                                                "object"
                                                            ]
                                                        },
                                                        "description": {
                                                            "type": "string"
                                                        },
                                                        "enum": {
                                                            "type": "array",
                                                            "items": {
                                                                "type": "string"
                                                            }
                                                        }
                                                    },
                                                    "required": ["type"]
                                                }
                                            },
                                            "required": {
                                                "type": "array",
                                                "items": { "type": "string" },
                                                "description": "必填参数列表"
                                            }
                                        },
                                        "required": ["type", "properties"]
                                    }
                                },
                                "required": ["name", "description"]
                            }
                        },
                        "required": ["type", "function"]
                    },
                    "tags": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "工具标签，一个工具可属于多个类别",
                        "minItems": 1
                    },
                    "command": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "CLI 命令数组，使用 ${paramName} 引用参数",
                        "examples": [
                            ["curl", "wttr.in/${city}"],
                            ["bun", "test", "${testFile}"]
                        ]
                    }
                },
                "required": ["def", "tags", "command"],
                "additionalProperties": false
            }
        }
    },
    "required": ["tools"],
    "additionalProperties": false
}
